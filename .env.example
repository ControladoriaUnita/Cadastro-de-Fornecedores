# Copie para .env.local e preencha. Nunca prefixe credenciais com VITE_ (iriam para o navegador).

# Login da equipe: dev = seletor de usuário (só localhost) · entra = Microsoft Entra ID
AUTH_MODE=dev
# Segredo para assinar o cookie de sessão (32+ caracteres aleatórios)
SESSION_SECRET=
# Microsoft Entra ID (quando AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Banco (Neon)
DATABASE_URL=

# UAU — usuário de integração (mesmo do app de Insumos)
UAU_MODE=real
UAU_BASE_URL=
UAU_INTEGRATION_TOKEN=
UAU_LOGIN=
UAU_PASSWORD=
# simulacao (padrão): valida e mostra o JSON, não grava · real: grava no UAU
UAU_GRAVACAO=simulacao
# Usuário gravado como "cadastrado por" no UAU
UAU_USUARIO_CADASTRO=
# Pasta dos anexos, relativa a #Arquivos do UAU. Cada fornecedor vira "<código UAU> - <NOME>"
UAU_PASTA_ANEXOS=1-UNITA\UNITA\3-Suprimentos\5 - Cadastro e qualificação de fornecedores
# Empresa do UAU registrada no histórico dos anexos (obrigatória). 1 = UNITÀ ENGENHARIA SA
UAU_EMPRESA=1

# E-mail: log (terminal + Painel dev) · graph (Microsoft 365) · none
EMAIL_PROVIDER=log
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
EMAIL_SENDER=
APP_URL=http://localhost:5175

# Arquivos: Vercel Blob (sem token, ficam em .data/uploads — só desenvolvimento)
BLOB_READ_WRITE_TOKEN=

# Portal da Transparência (sanções CEIS/CNEP) — chave gratuita
TRANSPARENCIA_API_KEY=
